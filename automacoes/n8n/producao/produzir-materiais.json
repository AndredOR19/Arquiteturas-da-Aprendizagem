      "name": "Aguardando sua revisão",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3300,
        -120
      ],
      "parameters": {
        "jsCode": "return [{json:(function pacoteParaRevisao(res,p){\n  const a=res?.artifacts?.find(a=>a.name==='estacao-'+p.pedido_id);\n  if(!a||a.expired||!Number.isSafeInteger(a.id))throw Error('Pacote ausente ou expirado. Não afirmar produção entregue.');\n  return {pedido_id:p.pedido_id,material_id:p.material_id,estado:'aguardando_revisao',aprovado:false,publicado:false,\n    execucao:p.run_url,artefato:{id:a.id,nome:a.name,bytes:a.size_in_bytes},\n    observacao:'Baixar pela execução privada. Sucesso técnico não equivale a revisão linguística, pedagógica, visual ou aprovação editorial.'};\n})($json,$('Conferir produção').item.json)}];"
      }
