    {
      "id": "Identificar_execu__o",
      "name": "Identificar execução",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        0
      ],
      "parameters": {
        "jsCode": "const p=(function localizarExecucao(res,p){\n  if(!Array.isArray(res?.workflow_runs))throw Error('Resposta de execuções inválida.');\n  const encontrados=res.workflow_runs.filter(r=>r.display_title==='estacao-'+p.pedido_id&&r.event==='workflow_dispatch');\n  if(encontrados.length>1)throw Error('Pedido repetido em mais de uma execução. Conferência necessária.');\n  const n=p.tentativas+1;\n  if(!encontrados.length){if(n>=120)throw Error('Prazo excedido sem localizar execução. Confira no GitHub antes de repetir.');return {...p,tentativas:n,finalizada:false};}\n  const r=encontrados[0];\n  if(!Number.isSafeInteger(r.id)||!/^https:\\/\\/github\\.com\\/AndredOR19\\/Biblioteca-de-Diagramacao\\/actions\\/runs\\/\\d+$/.test(r.html_url||''))throw Error('Execução não reconhecida.');\n  return {...p,tentativas:n,run_id:r.id,run_url:r.html_url,finalizada:r.status==='completed',conclusao:r.conclusion};\n})($json,$('Aguardar registro').item.json);return [{json:{...p,localizada:Number.isSafeInteger(p.run_id)}}];"
      }
    },
