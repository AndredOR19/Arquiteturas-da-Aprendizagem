    {
      "id": "Configurar_pedido",
      "name": "Configurar pedido",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "// Edite o material; conserve o ID para verificar um pedido já enviado.\nreturn [{json:{material_id:'aula-historia-192',pedido_id:'pedido-'+Date.now()}}];"
      }
    },
    {
      "id": "Validar_pedido",
      "name": "Validar pedido",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "return [{json:(function prepararPedido(p){\n  if(!p||!['aula-historia-192','capitulo-demonstracao'].includes(p.material_id))throw Error('Material não cadastrado.');\n  if(!/^[A-Za-z0-9][A-Za-z0-9_-]{7,79}$/.test(p.pedido_id||''))throw Error('ID do pedido inválido.');\n  return {pedido_id:p.pedido_id,material_id:p.material_id,tentativas:0,\n    repositorio:'AndredOR19/Biblioteca-de-Diagramacao',workflow:'estacao-automatica.yml',\n    base:'https://api.github.com/repos/AndredOR19/Biblioteca-de-Diagramacao',\n    dispatch:{ref:'main',inputs:{material:p.material_id,pedido_id:p.pedido_id}}};\n})($json)}];"
      }
    },
    {
      "id": "Solicitar_produ__o_privada",
      "name": "Solicitar produção privada",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.base + '/actions/workflows/' + $json.workflow + '/dispatches' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "options": {
          "timeout": 20000,
          "response": {
            "response": {
              "responseFormat": "json",
              "fullResponse": true
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.dispatch }}"
      }
    },
    {
      "id": "Conferir_solicita__o",
      "name": "Conferir solicitação",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "jsCode": "return [{json:(function conferirDisparo(res,p){\n  if(res?.statusCode!==204)throw Error('Disparo sem confirmação. Confira execuções pelo ID antes de reenviar; não repetir cegamente.');\n  return {...p,estado:'solicitado'};\n})($json,$('Validar pedido').first().json)}];"
      }
    },
