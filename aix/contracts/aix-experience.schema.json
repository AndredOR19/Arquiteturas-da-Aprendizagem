{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AndredOR19/Arquiteturas-da-Aprendizagem/aix/contracts/aix-experience-1.0.0.json",
  "title": "Contrato Universal AIx 1.0.0",
  "description": "Especificação estruturada de uma experiência pedagógica. O contrato carrega DADOS, nunca código: nenhum campo pode conter ou induzir execução de JavaScript arbitrário gerado por IA. Independente de fornecedor de LLM e de motor gráfico.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "experienceId", "generated", "request", "curriculum", "pedagogy", "experience", "assessment", "accessibility", "publication"],
  "properties": {
    "schemaVersion": { "enum": ["1.0.0", "1.1.0"] },
    "experienceId": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+){1,7}$", "minLength": 6, "maxLength": 64 },
    "generated": {
      "type": "object", "additionalProperties": false,
      "required": ["by", "pipelineVersion"],
      "properties": {
        "by": { "enum": ["aix-fabrica", "agente-ia", "manual"] },
        "pipelineVersion": { "type": "string", "minLength": 5 },
        "model": { "type": "string" },
        "promptVersion": { "type": "string" }
      }
    },
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["originalText", "requestId", "receivedAt"],
      "properties": {
        "originalText": { "type": "string", "minLength": 20 },
        "requestId": { "type": "string", "minLength": 6 },
        "receivedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}" }
      }
    },
    "curriculum": {
      "type": "object", "additionalProperties": false,
      "required": ["school", "grade", "classroom", "subject", "term", "skills", "sources", "pending"],
      "properties": {
        "school": { "type": "string", "minLength": 4 },
        "grade": { "type": "string", "minLength": 2 },
        "classroom": { "type": "string", "pattern": "^[0-9]{3}[A-Za-z]?$" },
        "subject": { "type": "string", "minLength": 4 },
        "term": { "enum": [1, 2, 3, "1º semestre", "2º semestre"] },
        "skills": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["code", "confirmed", "source"],
            "properties": {
              "code": { "type": "string", "minLength": 4 },
              "description": { "type": "string" },
              "confirmed": { "type": "boolean" },
              "source": { "type": "string", "minLength": 5 }
            }
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "kind"],
            "properties": {
              "path": { "type": "string", "minLength": 5 },
              "kind": { "enum": ["planejamento", "base-curricular", "banco-pedagogico", "ementa", "docente"] },
              "excerpt": { "type": "string" }
            }
          }
        },
        "pending": { "type": "boolean" }
      }
    },
    "pedagogy": {
      "type": "object", "additionalProperties": false,
      "required": ["architecture", "method", "stages", "justification"],
      "properties": {
        "architecture": { "enum": ["AEE", "MACI", "AEE-MACI", "EPC", "SVS", "AIES", "ARN", "ASA", "SSS", "AACI", "associativo"] },
        "method": { "enum": ["aula-expositiva-associativa", "investigacao-documental", "simulacao-historica", "laboratorio-experimental", "jogo-associacao", "exploracao-espacial", "resolucao-colaborativa", "narrativa-interativa", "alfabetizacao", "avaliacao-formativa", "percursos-interativos"] },
        "plantRef": { "type": "string" },
        "stages": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "enum": ["entender", "observar", "percursos", "explicar"] } },
        "drel": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "enum": ["dado", "relacao", "efeito", "limite"] } },
        "justification": { "type": "string", "minLength": 40 }
      }
    },
    "experience": {
      "type": "object", "additionalProperties": false,
      "required": ["template", "modes", "environments", "missions"],
      "properties": {
        "template": { "enum": ["percursos-interativos", "historical-museum", "document-investigation", "decision-simulator", "virtual-lab", "virtual-city", "collaborative-gincana", "association-literacy", "interactive-narrative"] },
        "modes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["2d", "3d", "accessible"] } },
        "narrative": { "type": "string" },
        "environments": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "title", "scenario"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "minLength": 3 },
              "title": { "type": "string", "minLength": 6 },
              "scenario": { "type": "string", "minLength": 20 },
              "interactions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 8 } },
              "paleta": {
                "type": "object", "additionalProperties": false, "required": ["fundo", "chao", "destaque"],
                "properties": {
                  "fundo": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
                  "chao": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
                  "destaque": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
                }
              },
              "layout": {
                "type": "object", "additionalProperties": false, "required": ["bounds", "spawn"],
                "properties": {
                  "bounds": {
                    "type": "object", "additionalProperties": false, "required": ["w", "h"],
                    "properties": { "w": { "type": "number", "exclusiveMinimum": 0 }, "h": { "type": "number", "exclusiveMinimum": 0 } }
                  },
                  "spawn": {
                    "type": "object", "additionalProperties": false, "required": ["x", "y"],
                    "properties": { "x": { "type": "number", "minimum": 0 }, "y": { "type": "number", "minimum": 0 } }
                  },
                  "obstacles": {
                    "type": "array",
                    "items": {
                      "type": "object", "additionalProperties": false, "required": ["x", "y", "w", "h"],
                      "properties": {
                        "x": { "type": "number", "minimum": 0 }, "y": { "type": "number", "minimum": 0 },
                        "w": { "type": "number", "exclusiveMinimum": 0 }, "h": { "type": "number", "exclusiveMinimum": 0 },
                        "label": { "type": "string", "minLength": 3 }
                      }
                    }
                  }
                }
              },
              "objects": {
                "type": "array",
                "items": {
                  "type": "object", "additionalProperties": false, "required": ["id", "tipo", "x", "y", "titulo", "descricao", "fictional"],
                  "properties": {
                    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "minLength": 3 },
                    "tipo": { "enum": ["documento", "cenario"] },
                    "x": { "type": "number", "minimum": 0 }, "y": { "type": "number", "minimum": 0 },
                    "titulo": { "type": "string", "minLength": 6 },
                    "descricao": { "type": "string", "minLength": 20 },
                    "fictional": { "type": "boolean" },
                    "sourceId": { "type": "string", "minLength": 3 }
                  }
                }
              },
              "characters": {
                "type": "array",
                "items": {
                  "type": "object", "additionalProperties": false, "required": ["id", "nome", "x", "y", "papel", "falas"],
                  "properties": {
                    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "minLength": 3 },
                    "nome": { "type": "string", "minLength": 4 },
                    "x": { "type": "number", "minimum": 0 }, "y": { "type": "number", "minimum": 0 },
                    "papel": { "type": "string", "minLength": 10 },
                    "falas": {
                      "type": "array", "minItems": 1,
                      "items": {
                        "type": "object", "additionalProperties": false, "required": ["id", "texto"],
                        "properties": {
                          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "minLength": 3 },
                          "texto": { "type": "string", "minLength": 20 }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "missions": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "environmentId", "title", "objective", "evidence"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "minLength": 3 },
              "environmentId": { "type": "string", "minLength": 3 },
              "title": { "type": "string", "minLength": 6 },
              "objective": { "type": "string", "minLength": 15 },
              "clues": { "type": "array", "items": { "type": "string", "minLength": 8 } },
              "evidence": { "type": "string", "minLength": 15 },
              "tasks": {
                "type": "array", "minItems": 1,
                "items": {
                  "type": "object", "additionalProperties": false, "required": ["tipo"],
                  "properties": {
                    "tipo": { "enum": ["coletar", "dialogar", "comparar"] },
                    "alvo": { "type": "string", "minLength": 3 },
                    "fala": { "type": "string", "minLength": 3 },
                    "pergunta": { "type": "string", "minLength": 15 },
                    "opcoes": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 2 } },
                    "correta": { "type": "integer", "minimum": 0 },
                    "feedbackAcerto": { "type": "string", "minLength": 15 },
                    "feedbackErro": { "type": "string", "minLength": 15 }
                  }
                }
              }
            }
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "title", "verified"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "minLength": 3 },
              "title": { "type": "string", "minLength": 6 },
              "type": { "enum": ["primaria", "secundaria", "didatica"] },
              "reference": { "type": "string" },
              "verified": { "type": "boolean" }
            }
          }
        }
      }
    },
    "assessment": {
      "type": "object", "additionalProperties": false,
      "required": ["strategy", "teacherReview"],
      "properties": {
        "strategy": { "enum": ["formativa", "somativa", "formativa-somativa"] },
        "teacherReview": { "const": true },
        "evidenceEvents": { "enum": ["coleta-educacional", "coleta-livre"] }
      }
    },
    "accessibility": {
      "type": "object", "additionalProperties": false,
      "required": ["wcag", "features"],
      "properties": {
        "wcag": { "const": "2.2-AA" },
        "features": { "type": "array", "minItems": 5, "items": { "enum": ["teclado", "leitor-de-tela", "contraste", "ajuste-de-fonte", "legendas", "transcricoes", "controle-de-audio", "reducao-de-movimento", "alternativa-arrastar", "instrucoes-claras", "apoio-imagens-voz"] } },
        "imageLearning": { "type": "boolean" }
      }
    },
    "publication": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "requiresApproval"],
      "properties": {
        "status": { "enum": ["draft", "pending-approval", "approved", "published"] },
        "requiresApproval": { "const": true },
        "approvedBy": { "type": "string", "minLength": 5 },
        "approvedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}" },
        "artifactSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "blockers": { "type": "array", "items": { "type": "string", "minLength": 8 } }
      }
    }
  }
}
